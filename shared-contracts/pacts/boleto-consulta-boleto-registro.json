{
  "consumer": {
    "name": "boleto-consulta"
  },
  "interactions": [
    {
      "description": "consultar boleto inexistente",
      "providerStates": [
        {
          "name": "boleto inexistente"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/interno/boletos/33333333-3333-4333-8333-333333333333"
      },
      "response": {
        "status": 404
      }
    },
    {
      "description": "consultar boleto registrado",
      "providerStates": [
        {
          "name": "boleto registrado"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/interno/boletos/11111111-1111-4111-8111-111111111111"
      },
      "response": {
        "body": {
          "codigo_barras": "NAO-PAGAVEL-SIM-BARRAS-11111111-1111-4111-8111-111111111111",
          "codigo_rejeicao": null,
          "data_hora_recebimento": "2026-10-20T10:00:00",
          "data_hora_registro": "2026-10-20T10:00:05",
          "identificador": "11111111-1111-4111-8111-111111111111",
          "identificador_registradora": "SIM-11111111-1111-4111-8111-111111111111",
          "linha_digitavel": "NAO-PAGAVEL-SIM-LINHA-11111111-1111-4111-8111-111111111111",
          "motivo_rejeicao": null,
          "status": "REGISTRADO"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.identificador_registradora": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "consultar boleto rejeitado",
      "providerStates": [
        {
          "name": "boleto rejeitado"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/interno/boletos/22222222-2222-4222-8222-222222222222"
      },
      "response": {
        "body": {
          "codigo_barras": null,
          "codigo_rejeicao": "SIM-REJ-001",
          "data_hora_recebimento": "2026-10-20T10:00:00",
          "data_hora_registro": null,
          "identificador": "22222222-2222-4222-8222-222222222222",
          "identificador_registradora": null,
          "linha_digitavel": null,
          "motivo_rejeicao": "Rejeicao simulada.",
          "status": "REJEITADO"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.motivo_rejeicao": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.6.14"
    },
