<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- POM PAI (agregador): define versões e perfis UMA vez; os módulos herdam. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>br.com.caixa.cobranca</groupId>
    <artifactId>central-cobranca</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Central de Cobranca e Boletos (projeto final BE-JV-010)</name>

    <!-- Ordem importa: shared-contracts primeiro, pois os servicos dependem dele. -->
    <modules>
        <module>shared-contracts</module>
        <module>infraestrutura-http</module>
        <module>eventos-outbox</module>
        <module>cobranca-broker</module>
        <module>boleto-emissor</module>
        <module>boleto-registro</module>
        <module>boleto-consulta</module>
    </modules>

    <properties>
        <!-- Java 17: e o JDK instalado nas maquinas do grupo (o gabarito PIX usa 21; ver ADR-001). -->
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <pact.version>4.6.14</pact.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>br.com.caixa.cobranca</groupId>
                <artifactId>infraestrutura-http</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.caixa.cobranca</groupId>
                <artifactId>eventos-outbox</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- Versao do shared-contracts definida aqui; modulos declaram sem versao. -->
            <dependency>
                <groupId>br.com.caixa.cobranca</groupId>
                <artifactId>shared-contracts</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.caixa.cobranca</groupId>
                <artifactId>cobranca-broker</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Dependencias comuns a TODOS os modulos (inclusive shared-contracts, por isso so teste). -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- Entrega em JVM: os perfis de referencia nao instalam outra infraestrutura. -->
    <profiles>
        <!-- Referencia conceitual; nao e um ambiente Docker operacional. -->
        <profile>
            <id>plano-a-docker</id>
        </profile>

        <!-- Plano B: pura-JVM, sem Docker. PADRAO do grupo. -->
        <profile>
            <id>plano-b-jvm</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
        </profile>

        <!-- Referencia conceitual; nao altera o transporte nem cria fallback automatico. -->
        <profile>
            <id>plano-c-conceitual</id>
        </profile>
    </profiles>
</project>
